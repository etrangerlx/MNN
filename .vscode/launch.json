{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug segment (Portrait / cat.jpg)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/segment.out",
      "args": [
        "${workspaceFolder}/resource/model/Portrait/Portrait.tflite.mnn",
        "${workspaceFolder}/resource/images/cat.jpg",
        "${workspaceFolder}/build/cat_segment.png"
      ],
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "preLaunchTask": "build segment.out (debug)",
      "stopAtEntry": false
    }
  ]
}